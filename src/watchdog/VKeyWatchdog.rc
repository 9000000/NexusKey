#include <windows.h>
#include "../core/Version.h"

// Icon IDs
#define IDI_APP              101

// Application Icon
IDI_APP              ICON    "resources/watchdog.ico"

// Version Information
VS_VERSION_INFO VERSIONINFO
    FILEVERSION    VKEY_VERSION_RC
    PRODUCTVERSION VKEY_VERSION_RC
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS      VS_FF_DEBUG
#else
    FILEFLAGS      0x0L
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "PhatMT97"
            VALUE "FileDescription",  "VKey Process Supervisor"
            VALUE "FileVersion",      VKEY_VERSION_STR
            VALUE "InternalName",     "VKeyWatchdog"
            VALUE "LegalCopyright",   "GPL-3.0-only"
            VALUE "OriginalFilename", "VKeyWatchdog.exe"
            VALUE "ProductName",      "VKey"
            VALUE "ProductVersion",   VKEY_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
